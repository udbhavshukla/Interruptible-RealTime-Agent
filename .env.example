# Copy to .env (never commit real secrets).
# The default provider is "none": answers are deterministic and fully offline.
# AURA_ENV=dev
# LOG_LEVEL=INFO

# --- Assistant model provider (optional) -----------------------------------
# AURA_LLM_PROVIDER=none        # none | mock | openai
# AURA_LLM_BASE_URL=https://api.openai.com/v1
# AURA_LLM_MODEL=gpt-4o-mini
# AURA_LLM_TIMEOUT_S=30
# AURA_LLM_API_KEY=             # server-side only; never exposed to the browser
